{
  "name": "private-poker-vite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:dev": "NEXT_PUBLIC_PRIVATE_POKER_CHAIN=devnode NEXT_PUBLIC_PRIVATE_POKER_MESH=dev vite",
    "build": "vite build && vite build --ssr server/standalone-entry.js --outDir dist/server --emptyOutDir false",
    "build-wasmer": "npm run build && cp wasmer.toml app.yaml ./dist",
    "lint": "eslint .",
    "test": "node --test src/tests/*.test.js",
    "test:live": "node --test src/tests/*.live-test.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@noble/bls12-381": "^1.4.0",
    "@noble/curves": "^1.9.1",
    "@noble/hashes": "^1.8.0",
    "@reown/appkit": "^1.8.19",
    "@reown/appkit-adapter-wagmi": "^1.8.19",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.90.21",
    "buffer": "^6.0.3",
    "lucide-react": "^1.6.0",
    "privatepoker-p2p": "file:../privatepoker-p2p",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "viem": "^2.47.6",
    "wagmi": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.1",
    "vite-plugin-standalone": "^2.0.0-alpha.5"
  }
}
